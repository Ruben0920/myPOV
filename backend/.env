# myPOV/backend/.env.example

# Django Core Settings
# ------------------------------------------------------------------------------
# SECURITY WARNING: keep the secret key used in production secret!
# Generate a new secret key for your project.
# You can generate one using: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY='django-insecure-nh=@+34mxky*x%s8jn+w-%e!k!n-9l2=t_m29s9u1^cd(z*#_s'

# SECURITY WARNING: don't run with debug turned on in production!
# Set to True for development, False for production
DEBUG=True

# Allowed Hosts
# Comma-separated list of hosts. For development, '*' can be used, but be specific in production.
# Example: ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
ALLOWED_HOSTS='*'

# Database Settings (Example for PostgreSQL - adapt if using something else)
# ------------------------------------------------------------------------------
# If you switch to PostgreSQL as originally planned, you'd use something like this.
# For the current SQLite setup in settings.py, these are not strictly needed there yet,
# but it's good practice to prepare for them.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/NAME
# OR individual components:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=mypov_db
# DB_USER=mypov_user
# DB_PASSWORD=your_db_password
# DB_HOST=localhost
# DB_PORT=5432

# Pusher Settings (for real-time chat)
# ------------------------------------------------------------------------------
# Replace with your actual Pusher App credentials
# PUSHER_APP_ID='YOUR_PUSHER_APP_ID'
# PUSHER_KEY='YOUR_PUSHER_KEY'
# PUSHER_SECRET='YOUR_PUSHER_SECRET'
# PUSHER_CLUSTER='YOUR_PUSHER_CLUSTER' # e.g., 'eu', 'ap1', 'us2'

# Gemini API Key (for AI interest inference)
# ------------------------------------------------------------------------------
